{
  "name": "@nourplay/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --offline",
    "start:lan": "expo start --offline --lan",
    "start:localhost": "expo start --offline --localhost",
    "start:clear": "expo start --offline -c",
    "start:online": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit --incremental false",
    "test:e2e": "maestro test .maestro/flows",
    "build:preview": "eas build --platform android --profile preview",
    "build:prod": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "^58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "~14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.26",
    "typescript": "~7.0.2"
  }
}
