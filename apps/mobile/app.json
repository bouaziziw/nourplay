{
  "expo": {
    "name": "NourPlay",
    "slug": "nourplay",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nourplay.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "app.nourplay.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c90d8"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#1c90d8"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow NourPlay to use Face ID to securely store tokens."
        }
      ],
      [
        "./plugins/withAndroidTV",
        {
          "banner": "./assets/tv-banner.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b64014b1-0255-4cca-b481-a8d3e7099eca"
      }
    },
    "owner": "wbouazizi"
  }
}
