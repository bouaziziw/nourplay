# Expo offline mode - skips cloud EAS manifest signing and telemetry
EXPO_OFFLINE=1
EXPO_NO_TELEMETRY=1

# Bypass self-signed cert issues caused by antivirus / local proxy inspection
NODE_TLS_REJECT_UNAUTHORIZED=0

# Backend API URL for mobile devices on LAN
EXPO_PUBLIC_API_URL=http://192.168.1.200:4000/api/v1
