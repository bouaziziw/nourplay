{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@nourplay/ui": ["../../packages/ui/src/index.ts"],
      "@nourplay/i18n": ["../../packages/i18n/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "messages/**/*.json", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
