{
  "name": "nourplay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "dotenv -e .env -- pnpm --filter @nourplay/db migrate:dev",
    "db:migrate:prod": "dotenv -e .env -- pnpm --filter @nourplay/db migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @nourplay/db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @nourplay/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.13",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^7.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4"
  }
}
