# ───────────────────────────────────────────────────────────
#  NourPlay — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ───────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
APP_NAME=NourPlay
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001

# ── Base de données ─────────────────────────────────────────
DATABASE_URL=postgresql://nourplay:secret@localhost:5432/nourplay
DATABASE_URL_TEST=postgresql://nourplay:secret@localhost:5432/nourplay_test

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth — JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=changeme-dev-access-secret-min-32-chars
JWT_REFRESH_SECRET=changeme-dev-refresh-secret-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Auth — 2FA ───────────────────────────────────────────────
TOTP_APP_NAME=NourPlay
TOTP_ISSUER=NourPlay

# ── Auth — OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── Email ────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@nourplay.app
RESEND_API_KEY=

# ── Stockage S3 (Cloudflare R2) ──────────────────────────────
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nourplay-assets
S3_PUBLIC_URL=https://assets.nourplay.app

# ── Vidéo — Sources externes ─────────────────────────────────
YOUTUBE_API_KEY=
VIMEO_ACCESS_TOKEN=

# ── IA — Validation contenu ──────────────────────────────────
OPENAI_API_KEY=
AI_MODERATION_MODEL=gpt-4o-mini
AI_MODERATION_THRESHOLD_APPROVE=0.85
AI_MODERATION_THRESHOLD_REVIEW=0.60

# ── Observabilité ────────────────────────────────────────────
OTEL_SERVICE_NAME=nourplay-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Sécurité ─────────────────────────────────────────────────
COOKIE_SECRET=changeme-dev-cookie-secret-min-32-chars
BCRYPT_ROUNDS=12
