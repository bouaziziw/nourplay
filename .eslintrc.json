{
  "extends": "next/core-web-vitals",
  "settings": {
    "react": {
      "version": "18.3"
    }
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "@next/next/no-html-link-for-pages": "off"
  },
  "overrides": [
    {
      "files": [
        "apps/mobile/**/*.tsx"
      ],
      "rules": {
        "@next/next/no-html-link-for-pages": "off",
        "@next/next/no-img-element": "off",
        "jsx-a11y/alt-text": "off"
      }
    },
    {
      "files": [
        "packages/api/**/*.ts",
        "packages/ui/**/*.tsx"
      ],
      "rules": {
        "@next/next/no-assign-module-variable": "off",
        "@next/next/no-html-link-for-pages": "off",
        "@next/next/no-img-element": "off"
      }
    }
  ]
}
