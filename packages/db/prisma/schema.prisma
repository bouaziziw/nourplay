generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  PARENT
  TEACHER
  MODERATOR
  ADMIN
}

enum AgeGroup {
  AGE_0_3
  AGE_4_6
  AGE_7_9
  AGE_10_12
  AGE_13_15
}

enum PlaylistVisibility {
  PRIVATE
  SHARED_LINK
  SHARED_USERS
}

enum PlaylistAccessRole {
  VIEWER
  EDITOR
}

enum VideoValidationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum AgeRating {
  ALL
  AGE_4_PLUS
  AGE_7_PLUS
  AGE_10_PLUS
  AGE_13_PLUS
}

enum ConsentType {
  TERMS
  PRIVACY
  COOKIE_ANALYTICS
  COOKIE_FUNCTIONAL
  PARENTAL_CONSENT
}

enum BlockType {
  CHANNEL_WHITELIST
  CHANNEL_BLACKLIST
  KEYWORD_BLACKLIST
  KEYWORD_WHITELIST
}

enum GdprRequestType {
  EXPORT
  DELETE
  RECTIFICATION
}

enum GdprRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  EXPIRED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

// ─────────────────────────────────────────────────────────────
//  User & Profils
// ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  role            UserRole  @default(PARENT)
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // chiffré en application

  // OAuth
  googleId String? @unique

  // Méta
  locale    String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // soft delete RGPD

  // Relations
  childProfiles    ChildProfile[]
  playlists        Playlist[]
  playlistAccesses PlaylistAccess[]
  refreshTokens    RefreshToken[]
  consentRecords   ConsentRecord[]
  auditLogs        AuditLog[]       @relation("ActorAuditLogs")
  blocks           UserBlock[]
  notifications    Notification[]
  gdprRequests     GdprRequest[]
  reportedVideos   VideoReport[]
  subscription     Subscription?
  legalDocuments   LegalDocument[]
  deviceTokens     DeviceToken[]

  // Stripe
  stripeCustomerId String? @unique

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model ChildProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  displayName  String
  birthYear    Int? // jamais la date exacte
  ageGroup     AgeGroup
  avatarKey    String? // clé S3 — jamais URL complète
  pinHash      String // PIN de déverrouillage

  // Contrôle parental
  viewingSchedule Json? // { "mon": ["08:00-12:00"], ... }
  dailyLimitMin   Int?
  sessionLimitMin Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]
  favorites    VideoFavorite[]

  @@index([userId])
  @@map("child_profiles")
}

// ─────────────────────────────────────────────────────────────
//  Auth
// ─────────────────────────────────────────────────────────────

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique // hash SHA-256 du token
  fingerprint String // hash user-agent + IP subnet
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
//  Sources vidéo
// ─────────────────────────────────────────────────────────────

model VideoSource {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique // "YouTube", "Vimeo", "Dailymotion"
  slug          String   @unique // "youtube", "vimeo"
  baseUrl       String
  embedAllowed  Boolean  @default(false)
  cguVersion    String?
  cguCheckedAt  DateTime?
  embedPolicy   Json? // règles parsées
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  videos Video[]

  @@map("video_sources")
}

// ─────────────────────────────────────────────────────────────
//  Vidéos
// ─────────────────────────────────────────────────────────────

model Video {
  id               String                @id @default(uuid()) @db.Uuid
  sourceId         String                @db.Uuid
  externalId       String // ID sur la plateforme source
  embedUrl         String
  title            String
  description      String?
  durationSec      Int?
  thumbnailUrl     String?
  language         String?
  ageRating        AgeRating             @default(ALL)
  validationStatus VideoValidationStatus @default(PENDING)
  validationScore  Float? // 0.0 → 1.0
  validationLog    Json? // détail de l'analyse IA
  publishedAt      DateTime? // date de publication sur la source
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  submittedById    String?               @db.Uuid

  // Relations
  source         VideoSource      @relation(fields: [sourceId], references: [id])
  playlistVideos PlaylistVideo[]
  tags           VideoTag[]
  watchHistory   WatchHistory[]
  reports        VideoReport[]
  favorites      VideoFavorite[]

  @@unique([sourceId, externalId]) // pas de doublon par plateforme
  @@index([validationStatus])
  @@index([language])
  @@index([ageRating])
  @@map("videos")
}

model Tag {
  id     String @id @default(uuid()) @db.Uuid
  name   String
  locale String @default("fr")

  videoTags VideoTag[]

  @@unique([name, locale])
  @@map("tags")
}

model VideoTag {
  videoId String @db.Uuid
  tagId   String @db.Uuid

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@map("video_tags")
}

// ─────────────────────────────────────────────────────────────
//  Playlists
// ─────────────────────────────────────────────────────────────

model Playlist {
  id             String             @id @default(uuid()) @db.Uuid
  ownerId        String             @db.Uuid
  name           String
  description    String?
  visibility     PlaylistVisibility @default(PRIVATE)
  targetAgeGroup AgeGroup[]
  languages      String[]
  shareToken     String?            @unique // token pour partage par lien
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  // Relations
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  playlistVideos PlaylistVideo[]
  categories     Category[]
  accesses       PlaylistAccess[]

  @@index([ownerId])
  @@index([visibility])
  @@map("playlists")
}

model PlaylistVideo {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @db.Uuid
  videoId    String   @db.Uuid
  position   Int
  addedAt    DateTime @default(now())
  addedById  String?  @db.Uuid

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
  @@map("playlist_videos")
}

model PlaylistAccess {
  id         String             @id @default(uuid()) @db.Uuid
  playlistId String             @db.Uuid
  grantedTo  String             @db.Uuid
  role       PlaylistAccessRole @default(VIEWER)
  createdAt  DateTime           @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [grantedTo], references: [id], onDelete: Cascade)

  @@unique([playlistId, grantedTo])
  @@map("playlist_accesses")
}

// ─────────────────────────────────────────────────────────────
//  Catégories (arbre)
// ─────────────────────────────────────────────────────────────

model Category {
  id         String  @id @default(uuid()) @db.Uuid
  playlistId String  @db.Uuid
  parentId   String? @db.Uuid
  name       String
  slug       String

  playlist Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  @@unique([playlistId, slug])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
//  Historique de visionnage
// ─────────────────────────────────────────────────────────────

model WatchHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  profileId          String   @db.Uuid
  videoId            String   @db.Uuid
  watchedAt          DateTime @default(now())
  durationWatchedSec Int      @default(0)
  completed          Boolean  @default(false)

  profile ChildProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  video   Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([profileId, watchedAt])
  @@map("watch_history")
}

// ─────────────────────────────────────────────────────────────
//  Favoris par profil enfant
// ─────────────────────────────────────────────────────────────

model VideoFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  videoId   String   @db.Uuid
  createdAt DateTime @default(now())

  profile ChildProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  video   Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([profileId, videoId])
  @@index([profileId])
  @@map("video_favorites")
}

// ─────────────────────────────────────────────────────────────
//  Blocs / Filtres
// ─────────────────────────────────────────────────────────────

model UserBlock {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  profileId String?   @db.Uuid // null = s'applique à tous les profils
  type      BlockType
  value     String // chaîne de caractères, ID de chaîne, mot-clé
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_blocks")
}

// ─────────────────────────────────────────────────────────────
//  Conformité RGPD
// ─────────────────────────────────────────────────────────────

model ConsentRecord {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  type        ConsentType
  version     String // ex: "2024-01-01"
  consentedAt DateTime    @default(now())
  ipHash      String // hash SHA-256 non réversible
  userAgent   String?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consent_records")
}

model GdprRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  type        GdprRequestType
  status      GdprRequestStatus @default(PENDING)
  requestedAt DateTime          @default(now())
  processedAt DateTime?
  exportUrl   String? // URL S3 signée (TTL 24h) pour export
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("gdpr_requests")
}

// ─────────────────────────────────────────────────────────────
//  Signalements vidéo
// ─────────────────────────────────────────────────────────────

model VideoReport {
  id          String   @id @default(uuid()) @db.Uuid
  videoId     String   @db.Uuid
  reportedBy  String   @db.Uuid
  reason      String
  description String?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  video    Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporter User  @relation(fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([videoId, resolved])
  @@map("video_reports")
}

// ─────────────────────────────────────────────────────────────
//  Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
//  Audit Log (insert-only, jamais modifié)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid // null pour actions système
  actorRole    String?
  action       String // ex: "playlist.create", "video.reject"
  resourceType String
  resourceId   String?
  metadata     Json?
  ip           String?
  userAgent    String?
  occurredAt   DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
//  Abonnements (socle premium — non actif en MVP)
// ─────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique // "Free", "Family", "School"
  slug          String       @unique
  priceEur      Int          @default(0) // centimes — 0 = gratuit
  interval      PlanInterval @default(MONTHLY)
  features      Json         // liste des fonctionnalités incluses
  isActive      Boolean      @default(true)
  stripePriceId String?      // Stripe Price ID (null pour le plan gratuit)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @unique @db.Uuid
  planId     String             @db.Uuid
  status     SubscriptionStatus @default(TRIALING)
  startedAt  DateTime           @default(now())
  expiresAt  DateTime?
  cancelledAt DateTime?
  // Référence Stripe (ou autre PSP) — null pour le plan gratuit
  externalId String?

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
//  Textes légaux (CGU, Politique de confidentialité…)
// ─────────────────────────────────────────────────────────────

model LegalDocument {
  id          String      @id @default(uuid()) @db.Uuid
  type        ConsentType
  version     String      // ex: "2026-01-01" — date ISO utilisée comme identifiant de version
  content     String      // Contenu Markdown
  publishedAt DateTime?   // null = brouillon
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?     @db.Uuid

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([type, version])
  @@index([type, publishedAt])
  @@map("legal_documents")
}

// ─────────────────────────────────────────────────────────────
//  Tokens de notifications push (Expo)
// ─────────────────────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique // Expo push token (ExponentPushToken[…])
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
